{
  "name": "vattu-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke-e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
