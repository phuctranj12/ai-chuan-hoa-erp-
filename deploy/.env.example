# Chép thành deploy/.env TRÊN SERVER rồi điền. File .env không bao giờ commit, rsync khi deploy giữ nguyên nó.

# Domain công khai của MCP (không có https://, không có cổng). Claude/ChatGPT kết nối tới https://<domain>/mcp
SERVER_DOMAIN=vattu-test.hawee.com.vn

# Cổng HTTPS trên host mà edge proxy chuyển tới (vd 442, 444…) — không trùng stack khác trên máy.
PUBLIC_HTTPS_PORT=444

# IP của edge proxy (openresty) nhìn từ server này — đúng MỘT địa chỉ.
TRUSTED_PROXY_IP=10.34.92.250

# Khoá mã hoá token ERP trong DB, 32 byte base64:   openssl rand -base64 32
# Mất/đổi khoá → mọi phiên cũ không giải mã được, người dùng chỉ cần kết nối lại.
VT_ENC_KEY=

# --- Tuỳ chọn (đã có mặc định đúng cho ERP Hawee) ---
# VT_ERP_TOKEN_URL=https://cm-api.erp.hawee.com.vn/connect/token
# VT_ERP_API_BASE=https://cm-api.erp.hawee.com.vn
# VT_ERP_BIM_BASE=https://bim.erp.hawee.com.vn
# VT_ERP_CLIENT_ID=CxmApi_App
# VT_LIVE_VERIFY_MAX_ROWS=50
# VT_LOG_LEVEL=info
# TZ=Asia/Ho_Chi_Minh
