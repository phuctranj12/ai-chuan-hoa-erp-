# Reverse proxy cho MCP "AI Chuẩn hóa vật tư ERP". File nằm ở /etc/nginx/templates/ trong image;
# entrypoint envsubst ra /etc/nginx/conf.d/default.conf (trong khối http{} → limit_req_zone hợp lệ ở đây).
#
#   client (Claude cloud / ChatGPT cloud / Claude Code) → edge proxy công ty (cert *.hawee.com.vn)
#     → server:${PUBLIC_HTTPS_PORT} → nginx này (443 trong container) → mcp:8080
#
# Không listen 80: edge lo chuyển HTTP → HTTPS.

# --- Rate limit theo IP thật (lớp chống dò quét; app còn giới hạn riêng cho form đăng nhập) ---
limit_req_zone $binary_remote_addr zone=vt_mcp:10m   rate=300r/m;
limit_req_zone $binary_remote_addr zone=vt_auth:10m  rate=30r/m;
limit_req_zone $binary_remote_addr zone=vt_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=vt_reg:10m   rate=10r/m;
limit_req_zone $binary_remote_addr zone=vt_file:10m  rate=60r/m;
limit_req_status 429;

upstream vt_mcp {
    server mcp:8080;
    keepalive 16;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_DOMAIN};

    # Đứng sau edge proxy: khai đúng MỘT địa chỉ edge; khai dải rộng = cho phép giả X-Forwarded-For.
    set_real_ip_from ${TRUSTED_PROXY_IP};
    real_ip_header   X-Forwarded-For;
    real_ip_recursive off;

    ssl_certificate     /etc/nginx/certs/server.crt;   # fullchain (lá + trung gian)
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/security_headers.conf;
    server_tokens off;
    proxy_hide_header X-Powered-By;

    client_max_body_size 64k;
    client_body_timeout  60s;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    # $remote_addr (đã qua real_ip), KHÔNG dùng $proxy_add_x_forwarded_for (nối thêm giá trị client tự bịa).
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    120s;
    proxy_redirect off;

    # =====================================================================================
    # OAuth cho Claude/ChatGPT. Thứ tự client gọi:
    #   POST /mcp (chưa token) → 401 + resource_metadata → /.well-known/oauth-protected-resource/mcp
    #   → /.well-known/oauth-authorization-server → POST /register → trình duyệt: /authorize
    #   → POST /oauth/login (đăng nhập ERP) → POST /token → POST /mcp
    # Thiếu MỘT location là client chỉ báo "không kết nối được".
    # =====================================================================================
    location ^~ /.well-known/oauth- {
        limit_req zone=vt_auth burst=20 nodelay;
        proxy_pass http://vt_mcp;
    }
    location = /.well-known/openid-configuration {
        limit_req zone=vt_auth burst=20 nodelay;
        proxy_pass http://vt_mcp;
    }
    location ^~ /.well-known/ {
        return 404;
    }

    location = /register {
        limit_req zone=vt_reg burst=5 nodelay;
        proxy_pass http://vt_mcp;
    }
    location ~ ^/(authorize|token|revoke)$ {
        limit_req zone=vt_auth burst=20 nodelay;
        proxy_pass http://vt_mcp;
    }
    # Form đăng nhập ERP: chặn dò mật khẩu ngay tầng mạng (app chặn thêm theo tài khoản).
    location = /oauth/login {
        limit_req zone=vt_login burst=5 nodelay;
        client_max_body_size 8k;
        proxy_pass http://vt_mcp;
    }

    # Điểm cuối MCP (chuẩn hoá tối đa 500 dòng/lần, xuất file tối đa 5.000 dòng).
    location = /mcp {
        limit_req zone=vt_mcp burst=60 nodelay;
        client_max_body_size 5m;
        proxy_read_timeout 180s;
        proxy_buffering off;
        proxy_pass http://vt_mcp;
    }

    # Link tải file kết quả (token bí mật trong đường dẫn — không ghi access log).
    location ^~ /files/ {
        limit_req zone=vt_file burst=10 nodelay;
        access_log off;
        proxy_pass http://vt_mcp;
    }

    location = /healthz {
        proxy_pass http://vt_mcp;
    }

    location / {
        return 404;
    }
}

# Request sai Host/SNI (dò quét bằng IP thô) → 421, không lộ gì.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    server_tokens off;
    return 421;
}
